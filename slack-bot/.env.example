# Settings for bot.py. Copy this file to .env in the same folder, fill it in,
# and run `chmod 600 .env`. Never commit .env. Where each value comes from:
# README.md in this folder.

# Slack app > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Slack app > Basic Information > App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-...
# GitHub fine-grained token for this repository, with Actions: Read and write
GITHUB_TOKEN=github_pat_...
# Slack member IDs of the people who may approve, separated by commas
ADMIN_SLACK_IDS=U01ABCDEF,U02GHIJKL
